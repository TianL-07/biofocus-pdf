{
  "name": "biofocus-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/geometry.test.mjs tests/youdao.test.mjs tests/library.test.mjs tests/export.test.mjs",
    "desktop": "npm run package && powershell -NoProfile -Command \"Start-Process -FilePath ./release/BioFocus-Windows/BioFocus.exe\"",
    "package": "npm run build && node scripts/build-windows.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "description": "A focused biomedical PDF reader for Windows, with line spotlight, annotations and Youdao medical translation.",
  "author": "BioFocus contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  }
}
